rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 메모: 공개 메모는 누구나 읽을 수 있고, 비공개 메모는 작성자만 읽을 수 있습니다.
    // 쓰기(작성/수정/삭제)는 작성자 본인만 가능합니다.
    match /memos/{memoId} {
      function isOwner(data) {
        return request.auth != null && data.uid == request.auth.uid;
      }
      function isValid(data) {
        return data.content is string
          && data.isPublic is bool
          && data.authorName is string
          && data.updatedAt is number;
      }

      allow read: if resource.data.isPublic == true || isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && isValid(request.resource.data);
      allow update: if isOwner(resource.data)
        && request.resource.data.uid == resource.data.uid
        && isValid(request.resource.data);
      allow delete: if isOwner(resource.data);
    }

    // 예전 저장 위치. 새 위치(memos)로 옮기기 위해 본인 읽기/삭제만 허용합니다.
    match /users/{uid}/memos/{memoId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
